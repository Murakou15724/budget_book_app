<!DOCTYPE html>
<html>
  <head>
    <title>BudgetBookApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="main-nav">
      <%= link_to "取引", transactions_path %>
      <%= link_to "資産管理", asset_snapshots_path %>
      <%= link_to "カテゴリ", categories_path %>
      <%= link_to "口座", accounts_path %>
      <%= link_to "支払方法", payment_methods_path %>
      <%= link_to "月別予算", edit_budget_plan_path %>
      <%= link_to "設定", edit_settings_path %>
    </nav>

    <% flash.each do |type, message| %>
      <div class="flash flash-<%= type %>"><%= message %></div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
