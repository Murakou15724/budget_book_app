<h1>クレカ未払い一覧</h1>
<%= render "application/info_note", icon: "🗓️",
      text: "設定した締め日・支払日から算出した支払予定日ごとにまとめています(祝日は考慮していないため、実際の支払日と数日ずれる場合があります)。" %>

<div class="stat-grid">
  <div class="stat-tile">
    <p class="stat-tile__label">未払い合計</p>
    <p class="stat-tile__value"><%= number_to_currency(@total, unit: "¥", precision: 0) %></p>
  </div>
  <div class="stat-tile">
    <p class="stat-tile__label">件数</p>
    <p class="stat-tile__value"><%= @grouped_transactions.values.sum(&:size) %>件</p>
  </div>
</div>

<%= render "grouped_form", grouped_transactions: @grouped_transactions %>
