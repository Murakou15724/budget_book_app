<section class="entry-card">
  <h2><%= "画像#{image_number} / " if local_assigns[:image_number] %><%= link_to "取込文書 ##{document.id}", import_document_path(document) %></h2>
  <p>取込元: <%= document.import_source.name %> / <%= document.import_source.service_key %> /
    <%= document.channel == "paypay_csv" ? "識別用元口座" : "元口座" %>: <%= document.import_source.account&.name || "不明（移行前）" %></p>
  <p>受付日時: <%= l document.received_at, format: :short %> / 入力種別: <%= document.channel %></p>
  <% if document.channel != "paypay_csv" %>
    <p>初回指定日: <%= document.manual_date || "指定なし" %> / 初回受付日: <%= document.fallback_date %>（再送では初回条件を維持します。変更は未処理候補を編集してください）</p>
  <% end %>
  <% if document.state == "extracted" %>
    <% if document.channel == "paypay_csv" %>
      <%= render "import_documents/csv_summary", summary: Imports::CsvSummary.call(document: document) %>
    <% else %>
      <% summary = import_document_summary(document) %>
      <p>解析完了 <%= summary[:count] %>行 / 新規 <%= summary[:classifications].fetch("new", 0) %>件 / 重複 <%= summary[:classifications].fetch("duplicate", 0) %>件 / 訂正 <%= summary[:classifications].fetch("correction", 0) %>件 / 保留 <%= summary[:classifications].fetch("hold", 0) %>件</p>
      <% summary[:states].each do |state, values| %><p><%= import_state_label(state) %>: <%= values[:count] %>件 / 金額 <%= values[:amount] %>円</p><% end %>
      <% if summary[:automatic][:count].positive? %>
        <p>自動反映 <%= summary[:automatic][:count] %>件（個別承認は不要） / 支出 <%= summary[:automatic][:expense] %>円 / 収入 <%= summary[:automatic][:income] %>円</p>
        <% summary[:rules].each do |rules, count| %>
          <p>適用ルール: <%= Array(rules).map { |rule| "##{rule['id']} v#{rule['version']} #{rule['merchant_key']}" }.join("、") %> / <%= count %>件</p>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <p><%= document.state == "failed" ? "解析失敗" : "解析未完了" %>（取引行数不明） / <%= import_reason_label(document.error_code) %>。元ファイルを再アップロードして再試行できます。</p>
  <% end %>
</section>
