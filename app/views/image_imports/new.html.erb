<%= link_to "← 戻る", "#", class: "back-link", data: { controller: "back", action: "click->back#go" } %>

<h1>画像から取引を登録</h1>
<%= render "application/info_note", icon: "🤖",
      text: "PayPayの支払い完了画面や、クレジットカードの利用履歴一覧のスクリーンショットをアップロードすると、AIが取引内容を読み取ります。1枚の画像に複数件の取引が写っていても、まとめて抽出します。複数枚を選択して同時にアップロードすることもできます。" %>

<div data-controller="upload-progress">
  <%= form_with url: image_imports_path, method: :post, multipart: true,
        data: { action: "submit->upload-progress#start" } do %>
    <div class="field">
      <%= label_tag :import_source_id, "取込元（サービス・元口座）" %>
      <%= select_tag :import_source_id, options_for_select(@sources.map { |s| ["#{s.name} / #{s.service_key} / #{s.account.name}", s.id] }), include_blank: "選択してください", required: true %>
      <%= link_to "取込元を設定", new_import_source_path %>
    </div>
    <div class="field">
      <%= label_tag :images, "画像ファイル(複数選択可)" %>
      <%= file_field_tag "images[]", multiple: true, accept: "image/jpeg,image/png,image/webp", required: true %>
    </div>

    <p>日付不明の行は未確定で保存します。抽出後に対象を選び、日付を一括指定できます。</p>

    <div class="actions">
      <%= submit_tag "アップロードして解析する" %>
    </div>
  <% end %>

  <div class="ai-loading-overlay" data-upload-progress-target="overlay">
    <div class="ai-loading-spinner"></div>
    <div class="ai-loading-icon" data-upload-progress-target="icon">📥</div>
    <p class="ai-loading-message" data-upload-progress-target="message">解析を準備しています…</p>
  </div>
</div>
