<%= form_with model: badge do |f| %>
  <% if badge.errors.any? %>
    <div class="error-messages">
      <% badge.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :required_xp, "必要XP" %>
    <%= f.number_field :required_xp, required: true %>
  </div>

  <div class="field">
    <%= f.label :title, "称号" %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= f.label :description, "説明" %>
    <%= f.text_field :description %>
  </div>

  <div class="actions">
    <%= f.submit "保存" %>
    <%= link_to "キャンセル", badges_path %>
  </div>
<% end %>
