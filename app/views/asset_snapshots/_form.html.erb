<%= form_with model: asset_snapshot do |f| %>
  <% if asset_snapshot.errors.any? %>
    <div class="error-messages">
      <% asset_snapshot.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :recorded_on, "記録日" %>
    <%= f.date_field :recorded_on, required: true %>
  </div>

  <h2>口座別残高</h2>
  <% ordered_balances = @accounts.map { |account| asset_snapshot.asset_balances.detect { |b| b.account_id == account.id } } %>
  <%= f.fields_for :asset_balances, ordered_balances do |bf| %>
    <div class="field">
      <%= bf.label :balance, bf.object.account.name %>
      <%= bf.hidden_field :account_id %>
      <%= bf.number_field :balance %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :memo, "メモ" %>
    <%= f.text_field :memo %>
  </div>

  <div class="actions">
    <%= f.submit "保存" %>
    <%= link_to "キャンセル", asset_snapshots_path %>
  </div>
<% end %>
