<h1>設定</h1>

<%= form_with model: @setting, url: settings_path do |f| %>
  <% if @setting.errors.any? %>
    <div class="error-messages">
      <% @setting.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :target_year, "対象年" %>
    <%= f.number_field :target_year %>
  </div>

  <div class="field">
    <%= f.label :total_savings_goal, "全体貯金目標" %>
    <%= f.number_field :total_savings_goal %>
  </div>

  <div class="field">
    <%= f.label :monthly_savings_goal, "毎月貯金目標" %>
    <%= f.number_field :monthly_savings_goal %>
  </div>

  <div class="field">
    <%= f.label :level_unit_amount, "貯金レベル換算額(この金額で1LV)" %>
    <%= f.number_field :level_unit_amount %>
  </div>

  <div class="field">
    <label><%= f.check_box :image_import_requires_approval %> 画像取込結果の確認を必須にする</label>
    <p class="text-muted">オフにすると、AIの抽出結果は確認なしでそのまま取引登録されます(内容が完全に確定できなかった候補のみレビュー画面に残ります)。</p>
  </div>

  <div class="actions">
    <%= f.submit "保存" %>
  </div>
<% end %>
