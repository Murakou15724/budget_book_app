<h1>月次振り返り</h1>

<p>
  <%= link_to "← #{@year - 1}年", monthly_reviews_path(year: @year - 1) %>
  <strong><%= @year %>年</strong>
  <%= link_to "#{@year + 1}年 →", monthly_reviews_path(year: @year + 1) %>
</p>

<div style="overflow-x: auto;">
  <table>
    <thead>
      <tr>
        <th>月</th>
        <th>収入実績</th>
        <th>支出実績</th>
        <th>予算残</th>
        <th>満足度</th>
        <th>コメント</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @monthly_summaries.each do |summary| %>
        <% review = @reviews_by_month[summary.month] %>
        <tr>
          <td><%= summary.month %>月</td>
          <td><%= number_to_currency(summary.income_actual, unit: "¥", precision: 0) %></td>
          <td><%= number_to_currency(summary.expense_actual, unit: "¥", precision: 0) %></td>
          <td><%= number_to_currency(summary.budget_remaining, unit: "¥", precision: 0) %></td>
          <td><%= review&.satisfaction %></td>
          <td><%= review&.comment %></td>
          <td><%= link_to "編集", edit_monthly_review_path(year: @year, month: summary.month) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
