<h1><%= @year %>年<%= @month %>月の振り返り</h1>

<p>
  収入実績: <%= number_to_currency(@summary.income_actual, unit: "¥", precision: 0) %> /
  支出実績: <%= number_to_currency(@summary.expense_actual, unit: "¥", precision: 0) %> /
  予算残: <%= number_to_currency(@summary.budget_remaining, unit: "¥", precision: 0) %>
</p>

<%= form_with model: @monthly_review, url: monthly_review_path(year: @year, month: @month), method: :patch do |f| %>
  <% if @monthly_review.errors.any? %>
    <div class="error-messages">
      <% @monthly_review.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :satisfaction, "満足度(1〜5、任意)" %>
    <%= f.select :satisfaction, (1..5), include_blank: true %>
  </div>

  <div class="field">
    <%= f.label :regret_note, "後悔支出" %>
    <%= f.text_area :regret_note %>
  </div>

  <div class="field">
    <%= f.label :good_spending_note, "良かった支出" %>
    <%= f.text_area :good_spending_note %>
  </div>

  <div class="field">
    <%= f.label :next_month_cut_note, "来月削るもの" %>
    <%= f.text_area :next_month_cut_note %>
  </div>

  <div class="field">
    <%= f.label :comment, "コメント" %>
    <%= f.text_area :comment %>
  </div>

  <div class="field">
    <%= f.label :next_action, "次の一手" %>
    <%= f.text_area :next_action %>
  </div>

  <div class="actions">
    <%= f.submit "保存" %>
    <%= link_to "キャンセル", monthly_reviews_path(year: @year) %>
  </div>
<% end %>
