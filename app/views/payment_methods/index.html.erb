<h1>支払・入金方法</h1>

<%= link_to "支払方法を追加", new_payment_method_path %>

<table>
  <thead>
    <tr>
      <th>名称</th>
      <th>備考</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @payment_methods.each do |payment_method| %>
      <tr>
        <td><%= payment_method.name %></td>
        <td><%= payment_method.note %></td>
        <td>
          <%= link_to "編集", edit_payment_method_path(payment_method) %>
          <%= link_to "削除", payment_method_path(payment_method), data: { turbo_method: :delete, turbo_confirm: "「#{payment_method.name}」を削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
