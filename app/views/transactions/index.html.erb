<h1>取引</h1>

<%= link_to "取引を追加", new_transaction_path, class: "btn-add" %>
<%= link_to "🧾 クレカ未払い一覧を確認", credit_card_unpaids_path, class: "btn" %>

<% if @quick_entry_templates.any? %>
  <div class="quick-entry-list">
    <% @quick_entry_templates.each do |template| %>
      <%= link_to template.name, new_transaction_path(quick_entry_template_id: template.id), class: "quick-entry-chip" %>
    <% end %>
  </div>
<% end %>

<div class="range-switcher">
  <% date_ranges.each do |range| %>
    <%= link_to range[:label], transactions_path(range: range[:key]),
          class: "range-switcher__item#{' is-active' if @date_range_key == range[:key]}" %>
  <% end %>
</div>

<% filters_active = index_filter_params.to_h.values.any?(&:present?) %>
<details class="filter-card" <%= "open" if filters_active %>>
  <summary class="filter-toggle">🔍 絞り込み<%= " (適用中)" if filters_active %></summary>
  <%= form_with url: transactions_path, method: :get, local: true do %>
    <div class="filter-grid">
      <div class="field">
        <%= label_tag :from_date, "日付(from)" %>
        <%= date_field_tag :from_date, @from_date %>
      </div>
      <div class="field">
        <%= label_tag :to_date, "日付(to)" %>
        <%= date_field_tag :to_date, @to_date %>
      </div>
      <div class="field">
        <%= label_tag :category_id, "カテゴリ" %>
        <%= select_tag :category_id,
              options_from_collection_for_select(Category.order(:kind, :position, :name), :id, :name, params[:category_id]),
              include_blank: "すべて" %>
      </div>
      <div class="field">
        <%= label_tag :direction, "取引種別" %>
        <%= select_tag :direction,
              options_for_select(Transaction::DIRECTION_LABELS.map { |k, v| [v, k] }, params[:direction]),
              include_blank: "すべて" %>
      </div>
      <div class="field">
        <%= label_tag :entry_type, "入力区分" %>
        <%= select_tag :entry_type,
              options_for_select(Transaction::ENTRY_TYPE_LABELS.map { |k, v| [v, k] }, params[:entry_type]),
              include_blank: "すべて" %>
      </div>
      <div class="field">
        <%= label_tag :credit_card_status, "クレカ支払状況" %>
        <%= select_tag :credit_card_status,
              options_for_select(Transaction::CREDIT_CARD_STATUS_LABELS.map { |k, v| [v, k] }, params[:credit_card_status]),
              include_blank: "すべて" %>
      </div>
    </div>
    <div class="actions">
      <%= submit_tag "絞り込む" %>
      <%= link_to "クリア", transactions_path %>
    </div>
  <% end %>
</details>

<div class="entry-list">
  <% @transactions.each do |transaction| %>
    <div class="entry-card">
      <div class="entry-card__row">
        <div class="entry-card__main">
          <p class="entry-card__title">
            <% if transaction.category %>
              <%= transaction.category.name %>
            <% else %>
              <span class="badge badge-neutral"><%= transaction.direction_label %></span>
            <% end %>
            <% if transaction.planned? %><span class="badge badge-neutral">予定</span><% end %>
          </p>
          <div class="entry-card__meta">
            <span><%= transaction.date %></span>
            <span>
              <%= transaction.payment_method.name %> / <%= transaction.account.name %>
              <% if transaction.to_account %> → <%= transaction.to_account.name %><% end %>
            </span>
          </div>
          <% if transaction.memo.present? || transaction.satisfaction || transaction.regret? || !transaction.not_applicable? %>
            <div class="entry-card__meta">
              <% if transaction.memo.present? %><span><%= transaction.memo %></span><% end %>
              <% if transaction.satisfaction %><span>😊 <%= transaction.satisfaction %></span><% end %>
              <% if transaction.regret? %><span class="badge badge-warning">後悔</span><% end %>
              <% unless transaction.not_applicable? %>
                <span class="badge <%= transaction.unpaid? ? 'badge-warning' : 'badge-good' %>"><%= transaction.credit_card_status_label %></span>
                <% if transaction.unpaid? %>
                  <span class="badge badge-neutral">支払予定: <%= transaction.credit_card_payment_due_on.strftime("%-m/%-d") %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        <p class="entry-card__amount <%= transaction_amount_css_class(transaction) %>">
          <%= transaction_amount_sign(transaction) %><%= number_to_currency(transaction.amount, unit: "¥", precision: 0) %>
        </p>
      </div>
      <div class="entry-card__actions">
        <%= link_to "編集", edit_transaction_path(transaction) %>
        <%= link_to "削除", transaction_path(transaction), data: { turbo_method: :delete, turbo_confirm: "この取引を削除しますか？" } %>
      </div>
    </div>
  <% end %>
</div>
