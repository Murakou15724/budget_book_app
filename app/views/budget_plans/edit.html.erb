<h1>月別予算</h1>

<div class="year-switcher">
  <%= link_to "← #{@year - 1}年", edit_budget_plan_path(year: @year - 1) %>
  <span><%= @year %>年</span>
  <%= link_to "#{@year + 1}年 →", edit_budget_plan_path(year: @year + 1) %>
</div>
<%= render "application/info_note", icon: "💡",
      text: "カテゴリごとに1〜12月の予算を個別に設定できます。空欄の月は基本月予算が使われます。基本月予算もここから変更できます。" %>

<%= form_with url: budget_plan_path, method: :patch do %>
  <%= hidden_field_tag :year, @year %>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>カテゴリ</th>
          <th>基本月予算</th>
          <% (1..12).each do |month| %>
            <th><%= month %>月</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.name %></td>
            <td><%= number_field_tag "categories[#{category.id}]", category.monthly_budget, class: "input-compact" %></td>
            <% (1..12).each do |month| %>
              <% existing = @existing_budgets[[category.id, month]] %>
              <td>
                <%= number_field_tag "budgets[#{category.id}-#{month}]", existing&.budget || category.monthly_budget, class: "input-compact" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="actions">
    <%= submit_tag "保存" %>
  </div>
<% end %>
