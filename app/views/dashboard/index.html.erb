<h1>ダッシュボード</h1>

<div class="year-switcher">
  <%= link_to "← #{@year - 1}年", dashboard_path(year: @year - 1) %>
  <span><%= @year %>年</span>
  <%= link_to "#{@year + 1}年 →", dashboard_path(year: @year + 1) %>
</div>

<div class="level-card">
  <div class="level-card__row">
    <div class="level-badge">
      <span class="level-badge__label">LV</span>
      <span class="level-badge__value"><%= @savings_level %></span>
    </div>
    <div style="flex: 1; min-width: 0;">
      <p class="level-card__goal">
        貯金目標進捗 <%= number_to_percentage(@goal_progress_rate * 100, precision: 1) %>
        (<%= number_to_currency(@total_assets, unit: "¥", precision: 0) %> / <%= number_to_currency(@total_savings_goal, unit: "¥", precision: 0) %>)
      </p>
      <div class="meter">
        <div class="meter__fill" style="width: <%= [[@goal_progress_rate * 100, 0].max, 100].min %>%;"></div>
      </div>
    </div>
  </div>
</div>

<% if @current_summary %>
  <h2>今月(<%= @current_month %>月)の収支</h2>
  <div class="stat-grid">
    <div class="stat-tile">
      <p class="stat-tile__label">収入見込み</p>
      <p class="stat-tile__value"><%= number_to_currency(@current_summary.income_estimate, unit: "¥", precision: 0) %></p>
    </div>
    <div class="stat-tile">
      <p class="stat-tile__label">支出実績</p>
      <p class="stat-tile__value"><%= number_to_currency(@current_summary.expense_actual, unit: "¥", precision: 0) %></p>
    </div>
    <div class="stat-tile">
      <p class="stat-tile__label">収支見込み</p>
      <p class="stat-tile__value <%= @current_summary.balance_estimate.negative? ? 'is-negative' : 'is-positive' %>">
        <%= number_to_currency(@current_summary.balance_estimate, unit: "¥", precision: 0) %>
      </p>
    </div>
    <div class="stat-tile">
      <p class="stat-tile__label">予算残額</p>
      <p class="stat-tile__value <%= @current_summary.budget_remaining.negative? ? 'is-negative' : '' %>">
        <%= number_to_currency(@current_summary.budget_remaining, unit: "¥", precision: 0) %>
      </p>
    </div>
    <div class="stat-tile">
      <p class="stat-tile__label">残り予算%</p>
      <p class="stat-tile__value <%= budget_remaining_rate_value_class(@current_summary) %>">
        <%= "⚠️ " if budget_remaining_rate_warning?(@current_summary) %><%= number_to_percentage(@current_summary.budget_remaining_rate * 100, precision: 1) %>
      </p>
    </div>
    <div class="stat-tile">
      <p class="stat-tile__label">今月の投資</p>
      <p class="stat-tile__value"><%= number_to_currency(@current_summary.investment_actual, unit: "¥", precision: 0) %></p>
    </div>
  </div>
  <p class="text-muted">投資・振替(口座間の資金移動)は生活費の支出には含まれません。</p>
<% else %>
  <h2>今月の収支</h2>
  <p class="text-muted"><%= @year %>年は現在の年ではないため、今月の集計は表示されません。</p>
<% end %>

<h2><%= @year %>年間収支・資産</h2>
<div class="stat-grid">
  <div class="stat-tile">
    <p class="stat-tile__label">年間収入</p>
    <p class="stat-tile__value"><%= number_to_currency(@annual_income, unit: "¥", precision: 0) %></p>
  </div>
  <div class="stat-tile">
    <p class="stat-tile__label">年間支出</p>
    <p class="stat-tile__value"><%= number_to_currency(@annual_expense, unit: "¥", precision: 0) %></p>
  </div>
  <div class="stat-tile">
    <p class="stat-tile__label">年間投資</p>
    <p class="stat-tile__value"><%= number_to_currency(@annual_investment, unit: "¥", precision: 0) %></p>
  </div>
  <div class="stat-tile">
    <p class="stat-tile__label">現在総資産</p>
    <p class="stat-tile__value"><%= number_to_currency(@total_assets, unit: "¥", precision: 0) %></p>
  </div>
  <div class="stat-tile">
    <p class="stat-tile__label">
      <%= @next_credit_card_payment_due_on ? "クレカ未払い(次回#{@next_credit_card_payment_due_on.strftime('%-m/%-d')})" : "クレカ未払い" %>
    </p>
    <p class="stat-tile__value">
      <%= link_to number_to_currency(@next_credit_card_payment_total, unit: "¥", precision: 0), credit_card_unpaids_path %>
    </p>
    <% if @next_credit_card_payment_due_on && @credit_card_unpaid_total != @next_credit_card_payment_total %>
      <p class="text-muted">未払い合計 <%= number_to_currency(@credit_card_unpaid_total, unit: "¥", precision: 0) %></p>
    <% end %>
  </div>
</div>

<% if @current_month %>
  <h2>カテゴリ別 今月支出</h2>
  <% if @category_expenses.empty? %>
    <p class="text-muted">今月は表示できる支出カテゴリがありません。</p>
  <% else %>
  <div class="entry-list">
    <% @category_expenses.each do |entry| %>
      <% rate = entry.usage_rate %>
      <div class="entry-card">
        <div class="entry-card__row">
          <div class="entry-card__main">
            <p class="entry-card__title"><%= entry.category.name %></p>
            <div class="entry-card__meta">
              <%= number_to_currency(entry.spent, unit: "¥", precision: 0) %> / <%= number_to_currency(entry.budget, unit: "¥", precision: 0) %>
            </div>
          </div>
          <% if rate %>
            <span class="badge <%= rate > 1 ? 'badge-critical' : rate >= 0.8 ? 'badge-warning' : 'badge-good' %>">
              <%= number_to_percentage(rate * 100, precision: 0) %>
            </span>
          <% end %>
        </div>
        <% if rate %>
          <div class="meter meter--neutral" style="margin-top: 0.5rem;">
            <div class="meter__fill <%= 'is-over' if rate > 1 %>" style="width: <%= [rate * 100, 100].min %>%;"></div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% end %>
<% end %>

<h2>月別収入・支出推移</h2>
<div class="card">
  <%= monthly_trend_svg(@monthly_summaries) %>
</div>

<% if @current_month && @category_expenses.present? %>
  <h2>カテゴリ別 今月支出(グラフ)</h2>
  <div class="card">
    <%= category_expense_bar_svg(@category_expenses) %>
  </div>
<% end %>
